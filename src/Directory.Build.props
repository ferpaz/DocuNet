<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Fernando Paz</Authors>
    <Company>Fernando Paz</Company>
    <Product>DocuNet</Product>
    <AssemblyTitle>$(MSBuildProjectName)</AssemblyTitle>
    <Description>Static HTML documentation generator for .NET assemblies and XML comments.</Description>
    <Copyright>Copyright (c) 2026 Fernando Paz</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DocuNet.Cli'">
    <Description>DocuNet command-line interface for generating static .NET API documentation.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DocuNet.Core'">
    <Description>DocuNet metadata reader, XML documentation parser and documentation model.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DocuNet.Rendering'">
    <Description>DocuNet static HTML rendering with editable external Spark templates.</Description>
  </PropertyGroup>
</Project>
